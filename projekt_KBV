<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projekt Titel | Portfolio</title>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            background-color: #111111; 
            color: #f4f4f4; 
            max-width: 1100px; 
            margin: 0 auto; 
            padding: 40px 20px; 
            line-height: 1.6; 
        }
        .back-link { 
            display: inline-block; 
            margin-bottom: 30px; 
            text-decoration: none; 
            color: #aaaaaa; 
            font-weight: bold; 
            transition: color 0.2s ease;
        }
        .back-link:hover { 
            color: #ffffff; 
        }
        h1 { 
            margin-bottom: 10px; 
            color: #ffffff;
        }
        .description { 
            max-width: 700px; 
            margin-bottom: 40px; 
            color: #bbbbbb; 
        }

        /* Video-Bereich im 16:9-Format */
        .video-section {
            display: flex;
            flex-direction: column;
            gap: 35px; /* Abstand zwischen Video 1 und Video 2 */
            margin-bottom: 45px;
        }
        .video-wrapper { 
            position: relative; 
            width: 100%; 
            aspect-ratio: 16 / 9; 
            background-color: #1e1e1e; 
        }
        .video-wrapper iframe, 
        .video-wrapper video { 
            position: absolute; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; 
            border: 0; 
            object-fit: cover;
        }
        
        /* Bildergalerie im 16:9-Format */
        .project-gallery { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); 
            gap: 25px; 
        }
        .project-gallery img { 
            width: 100%; 
            aspect-ratio: 16 / 9; 
            object-fit: cover; 
            display: block; 
            background-color: #1e1e1e; 
        }

        /* Auf kleinen Handy-Bildschirmen 1 Spalte statt 2 */
        @media (max-width: 600px) {
            .project-gallery {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- Zurück-Button zur Startseite -->
    <a href="index.html" class="back-link">← Zurück zu Ausgewählte Projekte</a>

    <!-- Projekttitel & Beschreibung -->
    <h1>Editorial Serie – Berlin</h1>
    <p class="description">Hier steht eine kurze Beschreibung zu deinem Projekt, deiner Rolle (z. B. Kamera, Schnitt, Art Direction) und dem Kunden.</p>

    <!-- Video-Bereich (2 Videos im 16:9-Format) -->
    <div class="video-section">
        
        <!-- VIDEO 1 -->
        <div class="video-wrapper">
            <video src="video1.mp4" poster="vorschau1.jpg" controls playsinline></video>
        </div>

        <!-- VIDEO 2 -->
        <div class="video-wrapper">
            <video src="video2.mp4" poster="vorschau2.jpg" controls playsinline></video>
        </div>

    </div>

    <!-- Bildergalerie (16:9) -->
    <div class="project-gallery">
        <img src="Einfach.jpeg" alt="Ansicht 1">
        <img src="bild2.jpg" alt="Ansicht 2">
        <img src="bild3.jpg" alt="Ansicht 3">
        <img src="bild4.jpg" alt="Ansicht 4">
    </div>

</body>
</html>
